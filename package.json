{
  "name": "command-mesh",
  "displayName": "Command Mesh",
  "description": "Live visual telemetry for Codex, Copilot, Kiro, and other coding agents.",
  "version": "0.1.0",
  "publisher": "local",
  "author": "Jeremy Hamilton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deemer15/command-mesh.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "commandMesh.open",
        "title": "Command Mesh: Open Activity Grid"
      },
      {
        "command": "commandMesh.openWeb",
        "title": "Command Mesh: Open Web Dashboard"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "commandMesh.open"
        }
      ]
    }
  }
}
