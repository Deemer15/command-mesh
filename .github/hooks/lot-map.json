{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node .github/lot-map-copilot-hook.js session-start",
        "powershell": "node .github/lot-map-copilot-hook.js session-start",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node .github/lot-map-copilot-hook.js prompt",
        "powershell": "node .github/lot-map-copilot-hook.js prompt",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node .github/lot-map-copilot-hook.js tool-start",
        "powershell": "node .github/lot-map-copilot-hook.js tool-start",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node .github/lot-map-copilot-hook.js tool-end",
        "powershell": "node .github/lot-map-copilot-hook.js tool-end",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "node .github/lot-map-copilot-hook.js agent-stop",
        "powershell": "node .github/lot-map-copilot-hook.js agent-stop",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "node .github/lot-map-copilot-hook.js error",
        "powershell": "node .github/lot-map-copilot-hook.js error",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
